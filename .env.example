# All values in this file are server-only. Never expose them through NEXT_PUBLIC_*.

# Authentication and authorization. JARVIS_USERS_JSON is the preferred multi-user
# configuration; JARVIS_PASSCODE remains a single-user compatibility option.
JARVIS_PASSCODE=
JARVIS_SESSION_SECRET=
JARVIS_USERS_JSON=
JARVIS_DEFAULT_USER_ID=
JARVIS_DEFAULT_USER_NAME=
JARVIS_DEFAULT_USER_ROLE=

# Vercel: connect a Neon Postgres Marketplace database.
# Cloudflare deployments can continue to use the existing DB binding instead.
DATABASE_URL=

# Development-only seeded data. Production ignores this switch.
ENABLE_DEMO_DATA=false

# Protects the scheduled daily portfolio-triage endpoint.
CRON_SECRET=

# Optional Gmail and Slack server-side integrations.
GMAIL_ACCESS_TOKEN=
GMAIL_DEFAULT_QUERY=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_IDS=

# Optional AI boundary. No provider is active until explicitly configured.
JARVIS_AI_PROVIDER=
OPENAI_API_KEY=
